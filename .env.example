# DeepSeek API. Never commit the real key.
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# Enterprise option: replace AI_BASE_URL with an internal OpenAI-compatible
# API gateway or a privately hosted model endpoint.
# AI_BASE_URL=https://ai-gateway.example.internal/v1

# Set to false only when the provider does not accept response_format.
AI_JSON_MODE=true
